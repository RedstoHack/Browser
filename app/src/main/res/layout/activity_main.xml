<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/identityChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/chip_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="120dp"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="👻"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/url_bg"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo|flagNoPersonalizedLearning"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/surface"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/BarButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btnForward"
            style="@style/BarButton"
            android:contentDescription="@string/forward"
            android:src="@drawable/ic_forward" />

        <ImageButton
            android:id="@+id/btnIdentity"
            style="@style/BarButton"
            android:contentDescription="@string/new_identity"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/btnReload"
            style="@style/BarButton"
            android:contentDescription="@string/reload"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btnMenu"
            style="@style/BarButton"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_menu" />
    </LinearLayout>
</LinearLayout>
